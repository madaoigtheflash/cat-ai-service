page {
  background: #FFF7FA;
  color: #3E2D35;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.65;
}

view, text, input, textarea, button, image, scroll-view {
  box-sizing: border-box;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(72rpx + env(safe-area-inset-bottom));
}

.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  background: #FFFFFF;
  border: 1rpx solid #F2DFE7;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(119, 64, 86, 0.06);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
}

.section-subtitle {
  color: #9D8490;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.55;
}

.btn-primary,
.btn-secondary,
.btn-ghost,
.btn-danger {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 28rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.btn-primary {
  color: #FFFFFF;
  background: linear-gradient(135deg, #FF6F91 0%, #FF91AA 100%);
  box-shadow: 0 12rpx 24rpx rgba(255, 111, 145, 0.2);
}

.btn-secondary {
  color: #D94F75;
  background: #FFF0F5;
}

.btn-ghost {
  color: #6F5A64;
  background: #F8F2F5;
}

.btn-danger {
  color: #D84343;
  background: #FFF0F0;
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 18rpx;
  color: #C94E70;
  background: #FFF0F5;
  border-radius: 24rpx;
  font-size: 22rpx;
}

.muted {
  color: #9D8490;
}

.empty-state {
  padding: 72rpx 24rpx;
  text-align: center;
}

.empty-icon {
  margin-bottom: 20rpx;
  font-size: 80rpx;
}

.empty-title {
  margin-bottom: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}

.empty-desc {
  margin-bottom: 28rpx;
  color: #9D8490;
  font-size: 24rpx;
  line-height: 1.7;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.5;
}

.form-input,
.form-textarea,
.picker-value {
  width: 100%;
  min-height: 88rpx;
  padding: 22rpx 24rpx;
  background: #FFF9FB;
  border: 1rpx solid #F2DFE7;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.55;
}

.form-textarea {
  min-height: 180rpx;
  line-height: 1.6;
}

.safe-tip {
  padding: 20rpx 22rpx;
  color: #765C67;
  background: #FFF3D8;
  border-radius: 18rpx;
  font-size: 23rpx;
  line-height: 1.6;
}

.section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 24rpx; margin: 44rpx 4rpx 24rpx; }
.section-heading > view { min-width: 0; }
.section-heading .section-title { display: block; margin: 0; font-size: 34rpx; font-weight: 700; line-height: 1.4; }
.section-note { display: block; margin-top: 6rpx; color: #9d8490; font-size: 23rpx; line-height: 1.5; }
.section-link { flex: none; padding: 10rpx 0; color: #d94f75; font-size: 24rpx; font-weight: 600; line-height: 1.45; }
.primary-button, .secondary-button { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 88rpx; padding: 20rpx 28rpx; border: 0; border-radius: 44rpx; font-size: 28rpx; font-weight: 600; line-height: 1.4; }
.primary-button { margin-top: 24rpx; color: #fff; background: linear-gradient(135deg, #ff6f91, #ff91aa); box-shadow: 0 12rpx 26rpx rgba(255,111,145,.2); }
.primary-button:active, .secondary-button:active { transform: scale(.98); }
.primary-button[disabled] { color: rgba(255,255,255,.86); background: #e5acbb; }
.secondary-button { color: #d94f75; background: #fff0f5; }
.compact { width: 240rpx; min-height: 88rpx; margin-top: 24rpx; padding: 18rpx 24rpx; }
.empty-card { display: flex; flex-direction: column; align-items: center; padding: 48rpx 26rpx; border-radius: 28rpx; background: #fff; text-align: center; }
.empty-title { display: block; margin-bottom: 9rpx; font-size: 29rpx; font-weight: 700; line-height: 1.45; }
.privacy-note { margin: 36rpx 12rpx 0; color: #9d8490; font-size: 22rpx; line-height: 1.65; text-align: center; }
