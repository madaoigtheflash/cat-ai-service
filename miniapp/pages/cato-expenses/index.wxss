@import "../../styles/cato-lab.wxss";

.expense-page { font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; }
.expense-kicker { color: #80616F; font-size: 23rpx; font-weight: 600; line-height: 1.55; margin: 8rpx 0 16rpx; }
.expense-card-header, .expense-record-header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 16rpx; }
.expense-card-header > text, .expense-record-header > view { min-width: 0; word-break: break-word; }
.expense-card-header .lab-heading { margin-bottom: 0; }
.expense-step { color: #80616F; font-size: 23rpx; line-height: 1.55; padding-top: 4rpx; }
.expense-editor > .lab-muted { margin-top: 16rpx; }
.expense-form { margin-top: 24rpx; }
.expense-label { display: block; margin-top: 24rpx; font-size: 27rpx; font-weight: 600; line-height: 1.65; word-break: break-word; }
.expense-amount { font-size: 36rpx; font-weight: 600; }
.expense-fields { display: flex; flex-wrap: wrap; gap: 16rpx; }
.expense-field { flex: 1 1 250rpx; min-width: 0; }
.expense-picker, .expense-month { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12rpx; min-height: 88rpx; padding: 22rpx 24rpx; margin: 16rpx 0; border: 1rpx solid #EBC6D4; border-radius: 20rpx; background: #FFFFFF; font-size: 27rpx; line-height: 1.55; }
.expense-picker > text, .expense-month > text { min-width: 0; word-break: break-word; }
.expense-picker-hint { color: #B94768; font-size: 24rpx; font-weight: 600; }
.expense-note { min-height: 168rpx; }
.expense-preview { margin-top: 24rpx; }
.expense-preview-amount, .expense-total { display: block; color: #3E2D35; font-size: 52rpx; font-weight: 700; line-height: 1.35; word-break: break-word; margin: 20rpx 0; }
.expense-detail { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 20rpx 0; border-bottom: 1rpx solid #F2DFE7; font-size: 27rpx; line-height: 1.65; }
.expense-detail > text:first-child { color: #80616F; flex: 0 0 72rpx; }
.expense-detail > text:last-child { flex: 1 1 250rpx; min-width: 0; word-break: break-word; white-space: pre-wrap; }
.expense-category-list { margin-top: 28rpx; border-top: 1rpx solid #F2DFE7; }
.expense-category-row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16rpx; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #F2DFE7; }
.expense-category-row > view { flex: 1 1 230rpx; min-width: 0; word-break: break-word; }
.expense-category-name, .expense-category-total { font-size: 27rpx; line-height: 1.55; font-weight: 600; word-break: break-word; }
.expense-record-description { flex: 1 1 260rpx; }
.expense-record-title { display: block; font-size: 30rpx; font-weight: 600; line-height: 1.45; word-break: break-word; }
.expense-record-description .lab-muted { margin-top: 12rpx; }
.expense-record-amount { font-size: 32rpx; font-weight: 600; line-height: 1.45; word-break: break-word; min-width: 0; }
.expense-record-note { display: block; color: #6F5A64; margin: 20rpx 0; font-size: 27rpx; line-height: 1.65; word-break: break-word; white-space: pre-wrap; }
.expense-actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.expense-actions button { flex: 1 1 180rpx; margin: 0; }
.expense-empty { text-align: center; }
.expense-empty-mark { display: block; color: #B94768; font-size: 48rpx; line-height: 1.4; margin-bottom: 20rpx; }
.expense-alert { padding: 0 24rpx; border: 1rpx solid #B94955; border-radius: 24rpx; background: #FFFFFF; margin-bottom: 24rpx; }
.expense-success { display: block; padding: 24rpx; margin-bottom: 24rpx; color: #3F8E75; background: #FFFFFF; border: 1rpx solid #F2DFE7; border-radius: 24rpx; font-size: 26rpx; line-height: 1.65; word-break: break-word; }
.expense-footer { margin-top: 40rpx; }
.expense-footer .lab-muted { margin-top: 16rpx; }
