.avatar-editor { display: flex; flex-direction: column; align-items: center; padding: 12rpx 0 36rpx; }.edit-avatar { display: flex; align-items: center; justify-content: center; width: 190rpx; height: 190rpx; border: 8rpx solid #fff; border-radius: 50%; background: #ffe2eb; box-shadow: 0 12rpx 28rpx rgba(119,64,86,.12); }.avatar-placeholder { font-size: 75rpx; }.avatar-action { margin-top: 16rpx; padding: 8rpx 16rpx; color: #d94f75; font-size: 24rpx; font-weight: 600; line-height: 1.5; }
.form-card { margin-bottom: 24rpx; }.form-section-title { display: block; margin-bottom: 30rpx; font-size: 32rpx; font-weight: 700; line-height: 1.4; }.form-row { display: flex; flex-wrap: wrap; gap: 20rpx; }.half { flex: 1 1 280rpx; min-width: 0; }.placeholder-text { color: #b9a3ad; }.save-button { margin-bottom: 20rpx; }
