.local-map-page { padding-bottom: calc(112rpx + env(safe-area-inset-bottom)); }
.map-heading { display: flex; align-items: center; gap: 16rpx; }
.map-icon { display: flex; flex: none; padding: 16rpx; border-radius: 22rpx; background: #FFF0F5; }
.map-title { min-width: 0; font-size: 42rpx; font-weight: 700; line-height: 1.35; word-break: break-word; }
.map-copy, .map-note, .record-name, .record-area, .selection-label, .record-warning { display: block; word-break: break-word; }
.map-copy { margin-top: 16rpx; color: #6F5A64; font-size: 27rpx; line-height: 1.65; }
.map-note { margin-top: 12rpx; color: #80616F; font-size: 23rpx; line-height: 1.6; }
.map-state { color: #6F5A64; }
.map-error { color: #B94955; word-break: break-word; }
.map-error .secondary-button { margin-top: 20rpx; }
.native-map-card { padding: 16rpx; overflow: hidden; }
.local-cat-map { width: 100%; height: 560rpx; border-radius: 20rpx; }
.native-map-card .map-note { padding: 4rpx 12rpx 8rpx; }
.selected-location { border-color: #EBC6D4; }
.selection-label { margin-bottom: 12rpx; color: #B94768; font-size: 23rpx; font-weight: 600; line-height: 1.55; }
.record-name { color: #3E2D35; font-size: 29rpx; font-weight: 600; line-height: 1.45; }
.record-area { margin-top: 8rpx; color: #6F5A64; font-size: 27rpx; line-height: 1.65; }
.record-warning { margin-top: 16rpx; color: #A66A20; font-size: 24rpx; line-height: 1.6; }
.location-row { display: flex; align-items: flex-start; gap: 16rpx; width: 100%; min-height: 104rpx; text-align: left; white-space: normal; }
.location-row.selected { border-color: #DFA1B6; background: #FFF0F5; }
.location-symbol { display: flex; flex: none; align-items: center; justify-content: center; min-height: 48rpx; }
.location-copy { flex: 1; min-width: 0; }
.map-empty .empty-title { margin-top: 20rpx; }
.map-other { margin-top: 40rpx; }
.map-other .secondary-button { margin-top: 24rpx; }
.map-footer, .omitted-note { margin: 24rpx 8rpx; }
.local-map-page button:active { transform: scale(.98); }
