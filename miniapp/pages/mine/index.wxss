.mine-hero { padding: 30rpx 28rpx; }
.mine-hero-main { display: flex; align-items: center; gap: 22rpx; }
.avatar-collage { display: flex; flex: none; }
.collage-avatar {
  display: flex; align-items: center; justify-content: center;
  width: 84rpx; height: 84rpx; margin-left: -18rpx;
  border: 4rpx solid #fff; border-radius: 50%;
  background: #FFF0F5; box-sizing: border-box;
}
.collage-avatar:first-child { margin-left: 0; }
.collage-empty { color: #D94F75; }
.mine-hero-copy { flex: 1; min-width: 0; }
.mine-title { display: block; font-size: 40rpx; font-weight: 700; line-height: 1.35; word-break: break-word; }
.mine-subtitle { display: block; margin-top: 8rpx; font-size: 23rpx; line-height: 1.55; word-break: break-word; }
.mine-manage { margin-top: 24rpx; }

.mine-section { margin: 40rpx 4rpx 20rpx; }

.asset-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18rpx; }
.asset-card {
  display: flex; min-width: 0; min-height: 208rpx; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx;
  padding: 22rpx 12rpx; border: 1rpx solid #F2DFE7; border-radius: 26rpx; background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(119, 64, 86, 0.05); text-align: center;
}
.asset-card:active { transform: scale(0.98); }
.asset-icon { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border-radius: 20rpx; background: #FFF0F5; }
.asset-value { color: #3E2D35; font-size: 40rpx; font-weight: 700; line-height: 1.3; }
.asset-label { color: #6F5A64; font-size: 22rpx; line-height: 1.5; word-break: break-word; }

.inline-error {
  display: flex; align-items: center; justify-content: space-between; gap: 18rpx;
  min-height: 88rpx; margin-top: 20rpx; padding: 16rpx 20rpx;
  border-radius: 20rpx; color: #A66A20; background: #FFF4DF; font-size: 23rpx; line-height: 1.55;
}
.inline-error-copy { flex: 1; min-width: 0; word-break: break-word; }
.inline-error-action { flex: none; color: #A66A20; font-weight: 700; }

.sighting-list { padding: 6rpx 24rpx; }
.mine-sighting { display: flex; align-items: center; gap: 18rpx; min-height: 104rpx; padding: 18rpx 0; border-bottom: 1rpx solid #F2DFE7; }
.mine-sighting:last-child { border-bottom: 0; }
.mine-sighting:active { opacity: 0.7; }
.mine-sighting-copy { flex: 1; min-width: 0; }
.mine-sighting-title { display: block; font-size: 27rpx; font-weight: 600; line-height: 1.45; word-break: break-word; }
.mine-sighting-meta { display: block; margin-top: 4rpx; font-size: 22rpx; line-height: 1.5; word-break: break-word; }
.mine-status { flex: none; padding: 6rpx 14rpx; border-radius: 16rpx; color: #A66A20; background: #FFF4DF; font-size: 21rpx; font-weight: 600; line-height: 1.45; }
.mine-status.approved { color: #3F8E75; background: #E8F5F0; }
.mine-status.rejected { color: #B94955; background: #FBE9EB; }

.link-list { padding: 6rpx 24rpx; }
.link-row { display: flex; align-items: center; gap: 18rpx; min-height: 104rpx; padding: 18rpx 0; border-bottom: 1rpx solid #F2DFE7; }
.link-row:last-child { border-bottom: 0; }
.link-row:active { opacity: 0.7; }
.link-row.disabled:active { opacity: 1; }
.link-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 18rpx; background: #FFF0F5; }
.link-copy { flex: 1; min-width: 0; }
.link-title { display: block; font-size: 27rpx; font-weight: 600; line-height: 1.45; word-break: break-word; }
.link-desc { display: block; margin-top: 4rpx; font-size: 22rpx; line-height: 1.5; word-break: break-word; }
.link-chevron { display: flex; flex: none; align-items: center; }

@media (max-width: 360px) {
  .asset-grid { grid-template-columns: minmax(0, 1fr); }
  .asset-card { min-height: 120rpx; flex-direction: row; justify-content: flex-start; text-align: left; padding: 20rpx 24rpx; }
  .asset-value { font-size: 32rpx; }
}
