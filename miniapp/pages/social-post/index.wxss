@import "../../styles/community.wxss";
.post-page { padding-bottom: calc(400rpx + env(safe-area-inset-bottom)); }
.post-page.has-reply { padding-bottom: calc(560rpx + env(safe-area-inset-bottom)); }
.post-page > .community-error { margin-bottom: 24rpx; }
.post-page .community-action, .post-page .prompt-button { width: 100%; max-width: 100%; }
.post-page .comment-reply-action, .post-page .cancel-reply, .post-page .comment-heading > button { width: auto; }
.notification-context { margin-top: 32rpx; padding: 24rpx; border: 1rpx solid #EBC6D4; border-radius: 24rpx; background: #FFF0F5; }
.notification-context-title { display: block; margin-bottom: 16rpx; color: #3E2D35; font-size: 30rpx; font-weight: 600; line-height: 1.5; word-break: break-word; }
.notification-parent { margin-bottom: 24rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid #EBC6D4; }
.notification-context .comment-reply-action { margin-top: 12rpx; }
.comments-more, .comments-error { margin-top: 24rpx; }
.post-status-note { margin-top: 24rpx; padding: 20rpx 24rpx; border-radius: 20rpx; color: #6F5A64; background: #FFF0F5; font-size: 25rpx; line-height: 1.65; word-break: break-word; }
.comment-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 32rpx 0 12rpx; }
.comment-heading > text { flex: 1; min-width: 0; color: #3E2D35; font-size: 32rpx; font-weight: 700; line-height: 1.4; word-break: break-word; }
.comment-heading > button { min-height: 88rpx; min-width: 88rpx; margin: 0; padding: 20rpx 0 20rpx 16rpx; color: #B94768; background: transparent; font-size: 26rpx; line-height: 1.5; }
.comment-empty { padding: 24rpx 0; color: #6F5A64; font-size: 27rpx; line-height: 1.7; word-break: break-word; }
.comment-item { padding: 24rpx 0 8rpx; border-bottom: 1rpx solid #F2DFE7; }
.comment-author { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8rpx 24rpx; color: #3E2D35; font-size: 27rpx; line-height: 1.55; font-weight: 600; word-break: break-word; }
.comment-author > text:first-child { min-width: 0; }
.comment-time { color: #80616F; font-size: 23rpx; font-weight: 400; }
.comment-reply-source { display: block; margin-top: 8rpx; color: #80616F; font-size: 24rpx; line-height: 1.55; word-break: break-word; }
.comment-content { display: block; margin-top: 12rpx; color: #6F5A64; font-size: 28rpx; line-height: 1.75; white-space: pre-wrap; word-break: break-word; }
.comment-reply-action { display: flex; align-items: center; min-height: 88rpx; min-width: 88rpx; padding: 16rpx 0; margin: 0; color: #B94768; background: transparent; font-size: 24rpx; line-height: 1.55; text-align: left; }
.comment-prompts { margin-top: 32rpx; }
.prompt-label { display: block; margin-bottom: 12rpx; color: #80616F; font-size: 24rpx; line-height: 1.6; word-break: break-word; }
.prompt-button { display: flex; align-items: center; min-height: 88rpx; width: 100%; margin: 12rpx 0 0; padding: 20rpx 24rpx; border: 1rpx solid #F2DFE7; border-radius: 24rpx; background: #FFFFFF; color: #6F5A64; font-size: 26rpx; line-height: 1.6; text-align: left; word-break: break-word; }
.comment-composer { position: fixed; z-index: 20; left: 0; right: 0; padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #F2DFE7; background: #FFFBFC; }
.comment-composer.keyboard-open { padding-bottom: 16rpx; }
.composer-input-row { display: flex; align-items: flex-end; gap: 16rpx; }
.comment-input { flex: 1; min-width: 0; min-height: 88rpx; max-height: 220rpx; padding: 16rpx 20rpx; border: 1rpx solid #F2DFE7; border-radius: 22rpx; background: #FFFFFF; color: #3E2D35; font-size: 28rpx; line-height: 1.6; box-sizing: border-box; }
.comment-placeholder { color: #80616F; }
.comment-send { display: flex; align-items: center; justify-content: center; flex: none; min-width: 112rpx; min-height: 88rpx; max-width: 164rpx; padding: 20rpx 20rpx; margin: 0; border-radius: 24rpx; color: #FFFFFF; background: #B94768; font-size: 27rpx; font-weight: 600; line-height: 1.5; word-break: break-word; }
.comment-send[disabled] { color: #80616F; background: #F2DFE7; }
.composer-count { display: block; padding-top: 8rpx; color: #80616F; font-size: 21rpx; line-height: 1.45; text-align: right; }
.composer-error, .composer-feedback { display: block; padding: 0 0 12rpx; color: #B94955; font-size: 24rpx; line-height: 1.55; word-break: break-word; }
.composer-feedback { color: #6F5A64; }
.composer-reply-target { display: flex; align-items: center; gap: 12rpx; padding-bottom: 12rpx; }
.composer-reply-copy { flex: 1; min-width: 0; }
.composer-reply-name { display: block; color: #B94768; font-size: 24rpx; font-weight: 500; line-height: 1.55; word-break: break-word; }
.composer-reply-quote { display: block; max-height: 80rpx; overflow-y: auto; color: #6F5A64; font-size: 23rpx; line-height: 1.6; word-break: break-word; }
.cancel-reply { display: flex; flex: none; align-items: center; justify-content: center; min-width: 88rpx; min-height: 88rpx; padding: 16rpx 0 16rpx 12rpx; margin: 0; color: #6F5A64; background: transparent; font-size: 24rpx; line-height: 1.5; }
