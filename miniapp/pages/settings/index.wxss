.settings-intro { display: flex; align-items: center; gap: 22rpx; padding: 15rpx 5rpx 32rpx; }
.settings-intro > view:last-child { min-width: 0; }
.settings-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; border-radius: 26rpx; color: #fff; background: linear-gradient(135deg,#ff6f91,#ff9db4); font-size: 42rpx; line-height: 1; }
.settings-title { display: block; font-size: 35rpx; font-weight: 700; line-height: 1.4; }
.settings-subtitle { display: block; margin-top: 7rpx; font-size: 22rpx; line-height: 1.6; word-break: break-word; }
.settings-card { padding-bottom: 28rpx; }
.group-title { display: block; margin-bottom: 28rpx; font-size: 30rpx; font-weight: 700; line-height: 1.45; }
.settings-actions { display: flex; flex-wrap: wrap; gap: 18rpx; }
.settings-button { flex: 1 1 260rpx; min-width: 0; margin-top: 0; }
.test-result { margin-top: 20rpx; padding: 18rpx; border-radius: 18rpx; font-size: 23rpx; line-height: 1.65; word-break: break-word; }
.test-result.success { color: #367f69; background: #e7f6f0; }
.test-result.failed { color: #98404c; background: #ffe5eb; }
.test-result.partial { color: #8b581b; background: #fff3d8; }
.path-row { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 0; border-bottom: 1rpx solid #f2dfe7; }
.path-row:last-child { border: 0; }
.path-row > view:last-child { min-width: 0; }
.path-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 20rpx; font-size: 20rpx; font-weight: 700; line-height: 1.3; }
.path-icon.local { color: #3b8972; background: #e3f4ee; }
.path-icon.cloud { color: #c34e70; background: #ffe9f0; }
.path-icon.shared { color: #6a5d80; background: #f3ecff; }
.path-title { display: block; font-size: 26rpx; font-weight: 700; line-height: 1.45; }
.path-note { display: block; margin-top: 6rpx; font-size: 22rpx; line-height: 1.6; word-break: break-word; }
.about-card { margin-top: 24rpx; }
.about-row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10rpx 24rpx; padding: 19rpx 0; border-bottom: 1rpx solid #f2dfe7; font-size: 24rpx; line-height: 1.55; }
.about-row:last-child { border: 0; }
.clear-button { min-height: 88rpx; padding: 18rpx 24rpx; border: 0; color: #b94955; background: transparent; font-size: 24rpx; line-height: 1.5; }
.dev-tip { margin-top: 18rpx; color: #6a5d80; background: #f3ecff; }
