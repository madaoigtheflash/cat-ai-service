.data-page { background: #FFFBFC; padding-bottom: calc(112rpx + env(safe-area-inset-bottom)); }
.data-hero { padding: 16rpx 4rpx 32rpx; }
.hero-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }
.hero-icon { flex: none; display: flex; padding: 8rpx 0; }
.data-title { min-width: 0; font-size: 44rpx; font-weight: 700; line-height: 1.35; word-break: break-word; }
.data-copy, .data-note, .row-title, .row-detail, .relation-reverse, .record-warning, .message-source, .message-time, .message-text { display: block; word-break: break-word; }
.data-copy { margin-top: 16rpx; color: #705260; font-size: 27rpx; line-height: 1.65; }
.data-note { margin-top: 12rpx; color: #80616F; font-size: 23rpx; line-height: 1.6; }
.state-card { color: #705260; box-shadow: none; }
.error-card { color: #B94955; word-break: break-word; box-shadow: none; }
.error-card .secondary-button { margin-top: 20rpx; }
.data-page button:not([size='mini']) { max-width: 100%; min-width: 0; width: 100%; box-sizing: border-box; white-space: normal; font-weight: 400; }
.summary-item { display: flex; align-items: center; gap: 16rpx; min-height: 88rpx; padding: 20rpx 4rpx; border-radius: 0; border-bottom: 1rpx solid #F2DFE7; background: transparent; color: #B94768; text-align: left; line-height: 1.55; word-break: break-word; }
.data-page button.summary-item:not([size='mini']) { width: 100%; min-width: 0; max-width: 100%; margin: 0; box-sizing: border-box; }
.summary-label { display: block; font-size: 26rpx; font-weight: 600; }
.summary-detail { display: block; margin-top: 4rpx; color: #80616F; font-size: 23rpx; }
.data-tabs { display: flex; gap: 8rpx; padding: 8rpx; border-radius: 28rpx; background: #FFF0F5; }
.data-page button.data-tab:not([size='mini']) { flex: 1 1 0; width: auto; min-height: 88rpx; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 4rpx 8rpx; margin: 0; padding: 16rpx 8rpx; border-radius: 22rpx; background: transparent; color: #705260; font-size: 25rpx; font-weight: 600; line-height: 1.55; }
.data-page button.data-tab.selected { color: #B94768; background: #fff; }
.tab-count { font-size: 23rpx; font-weight: 400; }
.data-page .section-heading { margin: 40rpx 4rpx 20rpx; }
.data-page .section-note { margin-top: 8rpx; color: #80616F; line-height: 1.6; }
.pet-row { display: flex; min-height: 120rpx; margin: 0; padding: 24rpx 4rpx; align-items: center; gap: 20rpx; border-radius: 0; border-bottom: 1rpx solid #F2DFE7; background: transparent; text-align: left; }
.pet-avatar { flex: none; width: 104rpx; height: 104rpx; border-radius: 28rpx; background: #FFF0F5; }
.pet-placeholder { display: flex; align-items: center; justify-content: center; }
.row-copy { flex: 1; min-width: 0; }
.row-title { font-size: 29rpx; color: #3E2D35; font-weight: 600; line-height: 1.45; }
.row-detail, .relation-reverse { margin-top: 8rpx; color: #705260; font-size: 26rpx; line-height: 1.65; }
.relation-row { padding: 28rpx 4rpx; border-bottom: 1rpx solid #F2DFE7; }
.relation-reverse { padding-top: 12rpx; }
.record-warning { margin-top: 16rpx; color: #A66A20; font-size: 24rpx; line-height: 1.6; }
.section-action { margin-top: 24rpx; }
.data-page .empty-card { box-shadow: none; }
.empty-card .empty-title { margin-top: 20rpx; }
.data-page button.receipt-row:not([size='mini']) { display: flex; align-items: flex-start; gap: 16rpx; width: 100%; min-width: 0; max-width: 100%; min-height: 88rpx; margin: 0; padding: 24rpx 4rpx; border-bottom: 1rpx solid #F2DFE7; border-radius: 0; background: transparent; box-sizing: border-box; text-align: left; white-space: normal; }
.receipt-symbol { display: flex; align-items: center; justify-content: center; flex: none; width: 48rpx; height: 48rpx; border-radius: 50%; background: #FFF0F5; }
.receipt-row > icon { flex: none; padding-top: 12rpx; }
.receipt-row .row-detail { font-size: 24rpx; }
.receipt-action { display: block; margin-top: 12rpx; color: #B94768; font-size: 24rpx; font-weight: 600; line-height: 1.55; word-break: break-word; }
.history-list { padding-top: 4rpx; }
.message-row { padding: 28rpx 24rpx; margin-bottom: 20rpx; border-radius: 24rpx; background: #FFF0F5; }
.message-row.mine { background: #FFFFFF; border: 1rpx solid #F2DFE7; }
.message-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8rpx 16rpx; }
.message-source { min-width: 0; color: #B94768; font-size: 24rpx; font-weight: 600; line-height: 1.55; }
.message-time { color: #80616F; font-size: 23rpx; line-height: 1.55; }
.message-text { margin-top: 16rpx; color: #3E2D35; font-size: 28rpx; line-height: 1.75; white-space: pre-wrap; }
.data-page button.primary-button { background: #B94768; font-weight: 600; box-shadow: none; }
.data-page button.secondary-button { color: #B94768; font-weight: 600; }
.export-note, .footer-note { margin: 20rpx 4rpx 0; }
.link-card { padding: 0 4rpx; }
.data-link { display: flex; align-items: center; gap: 20rpx; min-height: 104rpx; margin: 0; padding: 24rpx 0; border-radius: 0; border-bottom: 1rpx solid #F2DFE7; background: transparent; text-align: left; }
.data-link:last-child { border-bottom: 0; }
.data-page button:active { opacity: .82; }
@media (max-width: 360px) { .data-page button.data-tab:not([size='mini']) { flex-direction: column; } .pet-avatar { width: 88rpx; height: 88rpx; } .pet-row { gap: 16rpx; } }
