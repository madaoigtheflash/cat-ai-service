.online-page { padding-top: 28rpx; }
.online-hero { display: flex; align-items: center; gap: 24rpx; padding: 34rpx 32rpx; border: 1rpx solid #f2dfe7; border-radius: 32rpx; background: linear-gradient(145deg,#fff0f5,#fffbfc); box-shadow: 0 12rpx 30rpx rgba(119,64,86,.07); }
.online-hero-copy { flex: 1; min-width: 0; }
.online-eyebrow { display: block; margin-bottom: 8rpx; color: #d94f75; font-size: 21rpx; font-weight: 600; line-height: 1.45; }
.online-title { display: block; font-size: 38rpx; font-weight: 700; line-height: 1.38; word-break: break-word; }
.online-subtitle { display: block; margin-top: 12rpx; color: #765f69; font-size: 24rpx; line-height: 1.65; word-break: break-word; }
.online-mascot { pointer-events: none; display: flex; flex: none; align-items: center; justify-content: center; width: 130rpx; min-height: 130rpx; border-radius: 42rpx; background: rgba(255,255,255,.76); font-size: 42rpx; animation: cloud-float 3.8s ease-in-out infinite; }
@keyframes cloud-float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-7rpx); } }
.feedback { margin-top: 20rpx; padding: 20rpx 24rpx; border-radius: 20rpx; font-size: 24rpx; line-height: 1.65; word-break: break-word; }
.feedback.error { color: #b94955; background: #ffe8ed; }
.feedback.success { color: #3f8e75; background: #e8f5f0; }
.loading-wrap { margin-top: 28rpx; }
.loading-hint { display: block; margin-top: 16rpx; color: #765f69; font-size: 24rpx; text-align: center; }
@keyframes paw-breathe { 0%,100% { opacity: .5; transform: scale(.96); } 50% { opacity: 1; transform: scale(1.04); } }
.online-section-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; margin-top: 24rpx; padding: 10rpx; border: 1rpx solid #f2dfe7; border-radius: 28rpx; background: rgba(255,255,255,.92); box-shadow: 0 8rpx 24rpx rgba(119,64,86,.05); }
.section-tab { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rpx; width: 100%; min-width: 0; max-width: 100%; min-height: 96rpx; margin: 0; padding: 12rpx 8rpx; border-radius: 22rpx; color: #6f5a64; background: transparent; font-family: inherit; line-height: 1.45; }
.section-tab.is-active { color: #c94e70; background: #fff0f5; box-shadow: inset 0 0 0 1rpx #f3d6e2; }
.section-tab-label { max-width: 100%; font-size: 26rpx; font-weight: 700; line-height: 1.45; text-align: center; word-break: break-word; }
.section-tab-meta { max-width: 100%; color: #9d8490; font-size: 21rpx; font-weight: 400; line-height: 1.45; text-align: center; word-break: break-word; }
.section-tab.is-active .section-tab-meta { color: #d16a88; }
.section-panel { min-width: 0; }
.section-panel-heading { margin-top: 32rpx; }
.section-intro { margin-bottom: 20rpx; padding: 22rpx 24rpx; border: 1rpx solid #f2dfe7; border-radius: 22rpx; background: #fff9fb; }
.section-intro-title { display: block; font-size: 27rpx; font-weight: 700; line-height: 1.45; word-break: break-word; }
.section-intro-copy { display: block; margin-top: 7rpx; color: #6f5a64; font-size: 23rpx; line-height: 1.65; word-break: break-word; }
.section-context { display: flex; align-items: flex-start; gap: 14rpx; min-height: 88rpx; margin-bottom: 18rpx; padding: 18rpx 22rpx; border-radius: 20rpx; background: #f3ecff; }
.section-context-label { flex: none; padding-top: 2rpx; color: #796c91; font-size: 22rpx; font-weight: 600; line-height: 1.55; }
.section-context-value { flex: 1; min-width: 0; font-size: 25rpx; font-weight: 700; line-height: 1.55; word-break: break-word; }
.section-empty { margin-top: 0; }
.section-empty .muted { max-width: 100%; font-size: 23rpx; line-height: 1.65; word-break: break-word; }
.section-empty-action { margin-left: auto; margin-right: auto; }
.house-action-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; margin-bottom: 20rpx; padding: 10rpx; border: 1rpx solid #f2dfe7; border-radius: 26rpx; background: #fff; }
.house-action { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; width: 100%; min-width: 0; max-width: 100%; min-height: 96rpx; margin: 0; padding: 12rpx 6rpx; border: 1rpx solid transparent; border-radius: 20rpx; color: #6f5a64; background: #fff9fb; font-family: inherit; font-size: 23rpx; font-weight: 600; line-height: 1.4; text-align: center; word-break: break-word; }
.house-action.is-active { border-color: #ffd4df; color: #c94e70; background: #fff0f5; }
.house-action:active { transform: scale(.98); }
.house-action-icon { display: flex; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; border-radius: 14rpx; color: #d94f75; background: #fff; font-size: 21rpx; font-weight: 700; line-height: 1; }
.house-form-card, .invite-card { margin-bottom: 20rpx; padding: 26rpx; }
.house-form-title { display: block; color: #3e2d35; font-size: 29rpx; font-weight: 700; line-height: 1.45; word-break: break-word; }
.house-form-desc { display: block; margin-top: 8rpx; color: #6f5a64; font-size: 23rpx; line-height: 1.65; word-break: break-word; }
.house-submit { margin-top: 20rpx; }
.house-action-guide { margin-bottom: 20rpx; padding: 18rpx 22rpx; border-radius: 18rpx; color: #796c91; background: #f3ecff; font-size: 22rpx; line-height: 1.6; text-align: center; word-break: break-word; }
.invite-code-panel { margin-top: 20rpx; padding: 20rpx 22rpx; border: 1rpx solid #eadff5; border-radius: 20rpx; background: #f3ecff; }
.invite-code.large { margin-top: 6rpx; font-size: 34rpx; letter-spacing: 4rpx; text-align: center; }
.invite-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; margin-top: 18rpx; }
.invite-button { display: flex; align-items: center; justify-content: center; width: 100%; min-width: 0; max-width: 100%; min-height: 88rpx; margin: 0; padding: 18rpx 14rpx; border-radius: 44rpx; font-family: inherit; font-size: 24rpx; font-weight: 600; line-height: 1.45; text-align: center; word-break: break-word; }
.invite-button.copy { color: #d94f75; background: #fff0f5; }
.invite-button.share { color: #fff; background: linear-gradient(135deg,#ff6f91,#ff91aa); box-shadow: 0 10rpx 22rpx rgba(255,111,145,.16); }
.invite-button:active { transform: scale(.98); }
.invite-safety { display: block; margin-top: 16rpx; color: #a66a20; font-size: 21rpx; line-height: 1.65; word-break: break-word; }
.invite-unavailable { margin-bottom: 20rpx; }
.community-card { margin-bottom: 20rpx; }
.picker-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; min-height: 88rpx; padding: 20rpx 24rpx; border: 1rpx solid #f2dfe7; border-radius: 20rpx; background: #fff9fb; font-size: 26rpx; line-height: 1.5; }
.picker-row > text:first-child { min-width: 0; word-break: break-word; }
.picker-arrow { flex: none; color: #c9abb8; font-size: 30rpx; }
.community-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx 18rpx; margin-top: 18rpx; font-size: 23rpx; line-height: 1.55; }
.role-pill { padding: 7rpx 14rpx; border-radius: 18rpx; color: #c94e70; background: #fff0f5; font-size: 21rpx; font-weight: 600; line-height: 1.4; }
.invite-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 96rpx; margin-top: 20rpx; padding: 18rpx 22rpx; border-radius: 20rpx; background: #f3ecff; }
.invite-row > view { min-width: 0; }
.invite-label { display: block; color: #796c91; font-size: 21rpx; line-height: 1.45; }
.invite-code { display: block; margin-top: 4rpx; font-size: 29rpx; font-weight: 700; line-height: 1.4; letter-spacing: 3rpx; word-break: break-all; }
.copy-text { flex: none; color: #d94f75; font-size: 23rpx; font-weight: 600; }
.insights-entry { display: flex; align-items: center; gap: 18rpx; min-height: 104rpx; margin-top: 20rpx; padding: 18rpx 20rpx; border: 1rpx solid #eadff5; border-radius: 22rpx; background: linear-gradient(135deg,#fff7fa,#f3ecff); }
.insights-entry-active { transform: scale(.99); background: #fff0f5; }
.insights-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 66rpx; height: 66rpx; border-radius: 22rpx; color: #d94f75; background: #fff; font-size: 34rpx; font-weight: 700; }
.insights-copy { flex: 1; min-width: 0; }
.insights-title { display: block; font-size: 27rpx; font-weight: 700; line-height: 1.45; word-break: break-word; }
.insights-desc { display: block; margin-top: 4rpx; color: #796c91; font-size: 22rpx; line-height: 1.55; word-break: break-word; }
.insights-arrow { flex: none; color: #c9abb8; font-size: 42rpx; line-height: 1; }
.compact-input { width: 100%; min-height: 88rpx; margin-top: 16rpx; padding: 18rpx 20rpx; border: 1rpx solid #f2dfe7; border-radius: 18rpx; background: #fff9fb; font-size: 24rpx; line-height: 1.5; }
.code-input { text-transform: uppercase; }
.sync-card { display: flex; flex-direction: column; gap: 18rpx; }
.sync-list { display: flex; flex-direction: column; gap: 12rpx; }
.sync-row { display: flex; align-items: center; gap: 16rpx; min-height: 96rpx; padding: 14rpx 16rpx; border: 1rpx solid #f2dfe7; border-radius: 20rpx; background: #fff9fb; }
.sync-avatar { display: flex; flex: none; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 24rpx; background: #fff0f5; }
.sync-avatar-placeholder { font-size: 30rpx; }
.sync-copy { flex: 1; min-width: 0; }
.sync-name { display: block; font-size: 27rpx; font-weight: 700; line-height: 1.45; word-break: break-word; }
.sync-desc { display: block; margin-top: 3rpx; color: #9d8490; font-size: 21rpx; line-height: 1.55; word-break: break-word; }
.sync-status { flex: none; padding: 7rpx 13rpx; border-radius: 18rpx; color: #9d8490; background: #f8f2f5; font-size: 21rpx; font-weight: 600; line-height: 1.4; }
.sync-status.synced { color: #3f8e75; background: #e8f5f0; }
.sync-status.needs_sync { color: #a66a20; background: #fff3d8; }
.sync-actions { display: flex; flex-wrap: wrap; gap: 14rpx; }
.sync-button { width: 100%; }
.sync-actions .sync-button { flex: 1 1 270rpx; margin: 0; }
.sync-all-button { color: #796c91; background: #f3ecff; }
.sync-privacy { display: block; color: #9d8490; font-size: 22rpx; line-height: 1.65; word-break: break-word; }
.mini-empty { display: flex; flex-direction: column; gap: 8rpx; text-align: center; }
.mini-empty .muted { font-size: 23rpx; line-height: 1.65; word-break: break-word; }
.sighting-form { padding-bottom: 30rpx; }
.photo-picker { overflow: hidden; display: flex; align-items: center; justify-content: center; width: 100%; min-height: 330rpx; border: 2rpx dashed #e8cbd8; border-radius: 26rpx; background: #fff9fb; }
.photo-preview { width: 100%; height: 420rpx; }
.photo-empty { display: flex; flex-direction: column; align-items: center; padding: 42rpx 26rpx; text-align: center; }
.photo-icon { font-size: 58rpx; line-height: 1.2; }
.photo-title { margin-top: 14rpx; font-size: 28rpx; font-weight: 700; line-height: 1.45; }
.photo-empty .muted { margin-top: 8rpx; font-size: 22rpx; line-height: 1.6; word-break: break-word; }
.clear-photo { min-height: 88rpx; margin: 8rpx auto 18rpx; padding: 18rpx 24rpx; color: #d94f75; background: transparent; font-size: 23rpx; line-height: 1.5; }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.compact-item { min-width: 0; }
.location-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.location-button { display: flex; flex: 1 1 250rpx; align-items: center; justify-content: center; min-height: 88rpx; margin: 0; padding: 18rpx 22rpx; border-radius: 44rpx; color: #d94f75; background: #fff0f5; font-size: 24rpx; font-weight: 600; line-height: 1.45; }
.location-clear { color: #6f5a64; background: #f8f2f5; }
.location-selected { display: flex; align-items: flex-start; gap: 14rpx; margin-top: 14rpx; padding: 18rpx 20rpx; border-radius: 18rpx; background: #f3ecff; }
.location-dot { flex: none; margin-top: 5rpx; color: #ff6f91; font-size: 18rpx; line-height: 1.4; }
.location-copy { flex: 1; min-width: 0; }
.location-title { display: block; color: #796c91; font-size: 21rpx; font-weight: 600; line-height: 1.45; }
.location-label { display: block; margin-top: 4rpx; color: #3e2d35; font-size: 24rpx; line-height: 1.55; word-break: break-word; }
.location-purpose { display: block; margin-top: 14rpx; color: #6f5a64; font-size: 23rpx; line-height: 1.65; word-break: break-word; }
.location-note { display: block; margin-top: 8rpx; color: #6f5a64; font-size: 23rpx; line-height: 1.65; word-break: break-word; }
.privacy-tip { padding: 20rpx 22rpx; border-radius: 18rpx; color: #8b581b; background: #fff3d8; font-size: 23rpx; line-height: 1.65; word-break: break-word; }
.upload-button { margin-top: 24rpx; }
.feed-heading { margin-top: 32rpx; }
.feed-list { display: flex; flex-direction: column; gap: 22rpx; }
.sighting-card { overflow: hidden; border: 1rpx solid #f2dfe7; border-radius: 28rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(119,64,86,.055); }
.sighting-photo { display: flex; align-items: center; justify-content: center; width: 100%; height: 390rpx; background: #fff0f5; }
.photo-placeholder { font-size: 72rpx; }
.sighting-body { padding: 24rpx 26rpx 18rpx; }
.sighting-title-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx 14rpx; min-width: 0; }
.sighting-title { min-width: 0; font-size: 30rpx; font-weight: 700; line-height: 1.45; word-break: break-word; }
.status-pill { padding: 6rpx 13rpx; border-radius: 17rpx; color: #a66a20; background: #fff3d8; font-size: 21rpx; font-weight: 600; line-height: 1.4; }
.status-pill.approved { color: #3f8e75; background: #e8f5f0; }
.status-pill.rejected { color: #b94955; background: #ffe8ed; }
.sighting-meta, .sighting-caption, .sighting-owner { display: block; margin-top: 10rpx; font-size: 23rpx; line-height: 1.65; word-break: break-word; }
.sighting-meta, .sighting-owner { color: #9d8490; }
.sighting-caption { color: #6f5a64; }
.sighting-actions { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 0 22rpx 22rpx; }
.match-button, .review-button { display: flex; flex: 1 1 220rpx; align-items: center; justify-content: center; min-height: 88rpx; margin: 0; padding: 18rpx 22rpx; border-radius: 44rpx; font-size: 24rpx; font-weight: 600; line-height: 1.4; }
.match-button, .review-button.approve { color: #d94f75; background: #fff0f5; }
.enroll-button { color: #796c91; background: #f3ecff; }
.template-ready { display: flex; flex: 1 1 100%; align-items: flex-start; gap: 10rpx; padding: 16rpx 18rpx; border-radius: 18rpx; color: #3f8e75; background: #e8f5f0; font-size: 22rpx; font-weight: 600; line-height: 1.55; word-break: break-word; }
.template-ready text:first-child { flex: none; }
.template-ready text:last-child { min-width: 0; word-break: break-word; }
.review-button.reject { color: #b94955; background: #fff; border: 1rpx solid #f0d8dd; }
.feed-empty { padding: 54rpx 28rpx; }
.safety-note { margin: 34rpx 10rpx 0; padding: 22rpx 24rpx; border-radius: 20rpx; color: #765f69; background: #fff0f5; font-size: 22rpx; line-height: 1.7; word-break: break-word; }

@media (max-width: 360px) {
  .form-grid { grid-template-columns: 1fr; }
  .online-mascot { width: 104rpx; min-height: 104rpx; font-size: 34rpx; }
  .online-section-tabs { gap: 6rpx; padding: 8rpx; }
  .section-tab { min-height: 96rpx; padding-left: 4rpx; padding-right: 4rpx; }
  .section-tab-label { font-size: 24rpx; }
  .section-tab-meta { font-size: 21rpx; }
  .house-action-grid { gap: 6rpx; padding: 8rpx; }
  .house-action { min-height: 96rpx; padding-left: 3rpx; padding-right: 3rpx; font-size: 21rpx; }
  .invite-actions { grid-template-columns: minmax(0, 1fr); }
  .sync-row { align-items: flex-start; flex-wrap: wrap; }
  .sync-status { margin-left: 88rpx; }
}
