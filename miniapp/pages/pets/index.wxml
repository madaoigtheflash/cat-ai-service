<view class="page pets-page">
  <view class="pets-header">
    <view><text class="pets-title">我的猫咪</text><text class="muted pets-count">{{pets.length}} 份本地档案</text></view>
    <view class="header-actions">
      <button class="network-button" bindtap="openRelationships">猫际图</button>
      <button class="add-button" bindtap="addPet">＋ 新建</button>
    </view>
  </view>

  <view wx:if="{{pets.length}}" class="pet-list">
    <view class="pet-card" wx:for="{{pets}}" wx:key="id" data-id="{{item.id}}" bindtap="openPet">
      <image wx:if="{{item.imagePath}}" class="pet-avatar" src="{{item.imagePath}}" mode="aspectFill" />
      <view wx:else class="pet-avatar avatar-empty">🐾</view>
      <view class="pet-copy">
        <view class="pet-title-row"><text class="pet-name">{{item.name}}</text><text class="gender-pill">{{item.gender || '未知'}}</text></view>
        <text class="pet-breed">{{item.breed || '品种待补充'}}</text>
        <view class="pet-meta">
          <text wx:if="{{item.estimatedAge}}">{{item.estimatedAge}}</text>
          <text wx:if="{{item.weight}}">{{item.weight}} kg</text>
          <text wx:if="{{!item.estimatedAge && !item.weight}}">点击完善健康信息</text>
        </view>
      </view>
      <view class="more" catchtap="deletePet" data-id="{{item.id}}" data-name="{{item.name}}">···</view>
    </view>
  </view>

  <view wx:else class="empty-card pets-empty">
    <text class="empty-icon">🐈</text>
    <text class="empty-title">还没有猫咪档案</text>
    <text class="muted empty-copy">为猫咪记录基本特征、体重、疫苗与驱虫信息。</text>
    <button class="primary-button compact" bindtap="addPet">新建档案</button>
  </view>

  <view class="local-banner"><text class="local-icon">⌂</text><view><text class="local-title">隐私优先</text><text class="muted">当前档案仅保存在本机微信存储中，不会自动上传。</text></view></view>
</view>
