.compose-page { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.compose-title { display: block; font-size: 42rpx; line-height: 1.35; font-weight: 700; word-break: break-word; }
.compose-note { display: block; margin-top: 12rpx; font-size: 24rpx; line-height: 1.65; color: #705260; word-break: break-word; }
.compose-editor { margin-top: 32rpx; padding: 24rpx; border: 1rpx solid #EBC6D4; border-radius: 28rpx; background: #fff; }
.story-input { width: 100%; min-height: 184rpx; max-height: 420rpx; font-size: 28rpx; line-height: 1.65; color: #3E2D35; }
.story-input::placeholder { color: #80616F; }
.compose-counter { display: block; margin-top: 16rpx; font-size: 23rpx; color: #80616F; line-height: 1.55; }
.compose-section { margin-top: 40rpx; }
.compose-heading { display: block; font-size: 30rpx; line-height: 1.45; font-weight: 600; }
.compose-photos { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.compose-photo { flex: 0 1 calc(50% - 8rpx); max-width: 100%; min-width: 0; }
.compose-photo-preview { position: relative; width: 100%; padding-top: 75%; overflow: hidden; border-radius: 24rpx; background: #FFF0F5; }
.compose-photo image { position: absolute; top: 0; left: 0; display: block; width: 100%; height: 100%; }
.compose-primary, .compose-secondary, .photo-remove, .photo-cover { display: flex; align-items: center; justify-content: center; width: 100%; max-width: 100%; min-height: 88rpx; height: auto; padding: 20rpx 24rpx; border: 0; border-radius: 24rpx; white-space: normal; word-break: break-word; font-size: 28rpx; font-weight: 600; line-height: 1.5; }
/* Override style:v2's native button width without changing other pages. */
.compose-page button.compose-primary, .compose-page button.compose-secondary, .compose-page button.photo-remove, .compose-page button.photo-cover { width: 100%; min-width: 0; margin-left: 0; margin-right: 0; }
.compose-primary { margin-top: 24rpx; color: #fff; background: #B94768; }
.compose-secondary, .photo-remove { margin-top: 16rpx; color: #8D3652; background: #FFF0F5; }
.photo-remove, .photo-cover { font-size: 24rpx; }
.photo-cover { margin-top: 12rpx; color: #8D3652; background: #FFFFFF; border: 1rpx solid #EBC6D4; }
.compose-secondary[disabled], .photo-remove[disabled], .photo-cover[disabled] { color: #705260; background: #F2DFE7; }
.photo-cover.is-cover { color: #8D3652; background: #FFF0F5; }
.compose-primary[disabled] { color: #705260; background: #EBC6D4; }
.compose-page button.compose-primary[disabled], .compose-page button.compose-secondary[disabled], .compose-page button.photo-remove[disabled], .compose-page button.photo-cover[disabled] { color: #705260; background: #F2DFE7; }
.compose-page button.photo-cover.is-cover { color: #8D3652; background: #FFF0F5; }
.compose-check { display: flex; align-items: center; gap: 16rpx; min-height: 88rpx; padding: 16rpx 0; font-size: 26rpx; line-height: 1.65; }
.compose-check checkbox { flex: none; }
.compose-check text { flex: 1; min-width: 0; word-break: break-word; }
.compose-cat { padding: 20rpx 24rpx; border-radius: 24rpx; background: #FFF0F5; word-break: break-word; }
.compose-consent { margin-top: 40rpx; padding-top: 28rpx; border-top: 1rpx solid #EBC6D4; }
.compose-error { display: block; margin-top: 24rpx; padding: 20rpx; color: #A13F4A; background: #FBE9EB; border-radius: 20rpx; font-size: 26rpx; line-height: 1.65; word-break: break-word; }
.compose-footer { text-align: center; }
.compose-result { padding-top: 48rpx; }
.compose-result .compose-title { margin-top: 24rpx; }
.compose-progress { margin-top: 24rpx; padding: 24rpx 0; border-top: 1rpx solid #EBC6D4; }
.compose-progress-bar { margin-top: 16rpx; }
@media (max-width: 360px) { .compose-photo { flex-basis: 100%; } }
