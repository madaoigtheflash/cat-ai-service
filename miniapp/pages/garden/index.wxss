@import "../../styles/sakura.wxss";

.home-page { position: relative; z-index: 0; padding-top: 8rpx; }

/* Mono-aware petal field: three parallax depth layers drift down behind the
   content (negative z-index inside the page stacking context). Smaller,
   lighter, slower petals read as farther away — depth without blur filters. */
.petal-field { position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
.petal { position: absolute; top: -6%; border-radius: 90% 6rpx 90% 6rpx; animation: petal-fall linear infinite; }
.petal-near { width: 26rpx; height: 34rpx; background: linear-gradient(135deg, var(--sakura-rim), var(--sakura-fade)); animation-duration: 18s; }
.petal-mid { width: 20rpx; height: 26rpx; background: linear-gradient(135deg, var(--sakura-fade), #F0DEE6); animation-duration: 22s; }
.petal-far { width: 14rpx; height: 18rpx; background: linear-gradient(135deg, #F0E0E7, #F6EBF0); animation-duration: 26s; }
.petal:nth-child(1) { left: 10%; animation-delay: 0s; }
.petal:nth-child(2) { left: 30%; animation-delay: -8s; }
.petal:nth-child(3) { left: 47%; animation-delay: -15s; }
.petal:nth-child(4) { left: 63%; animation-delay: -5s; }
.petal:nth-child(5) { left: 79%; animation-delay: -12s; }
.petal:nth-child(6) { left: 90%; animation-delay: -19s; }
@keyframes petal-fall {
  0% { top: -6%; opacity: 0; transform: translateX(0) rotate(0deg); }
  8% { opacity: .85; }
  30% { transform: translateX(22rpx) rotate(115deg); }
  55% { transform: translateX(-14rpx) rotate(210deg); }
  80% { opacity: .7; transform: translateX(18rpx) rotate(300deg); }
  100% { top: 104%; opacity: 0; transform: translateX(-8rpx) rotate(385deg); }
}

.compact-context { margin: 0; padding: 24rpx; border-color: var(--sakura-stroke); border-radius: 32rpx; background: var(--sakura-paper); box-shadow: 0 8rpx 24rpx #A5677D0A; }
.compact-cat-row { display: flex; align-items: center; gap: 16rpx; }
.compact-avatar-orbit { position: relative; display: flex; flex: none; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; }
.avatar-orbit-ring { position: absolute; left: 50%; top: 50%; width: 0; height: 0; pointer-events: none; animation: spiral-spin-back 64s linear infinite; }
.orbit-dot { position: absolute; width: 10rpx; height: 10rpx; margin: -5rpx 0 0 -5rpx; border-radius: 50%; background: var(--sakura-rim); }
.orbit-dot:nth-child(2n) { width: 8rpx; height: 8rpx; margin: -4rpx 0 0 -4rpx; background: #EBB9CB; }
/* Two dimmer dots read as petals about to fall — wholeness and loss on one ring. */
.orbit-dot:nth-child(3), .orbit-dot:nth-child(7) { opacity: .35; }
/* Golden-angle (137.5°) petal ring echoes the spiral photo garden below. */
.orbit-dot:nth-child(1) { transform: rotate(0deg) translateY(-56rpx); }
.orbit-dot:nth-child(2) { transform: rotate(137.5deg) translateY(-56rpx); }
.orbit-dot:nth-child(3) { transform: rotate(275deg) translateY(-56rpx); }
.orbit-dot:nth-child(4) { transform: rotate(52.5deg) translateY(-56rpx); }
.orbit-dot:nth-child(5) { transform: rotate(190deg) translateY(-56rpx); }
.orbit-dot:nth-child(6) { transform: rotate(327.5deg) translateY(-56rpx); }
.orbit-dot:nth-child(7) { transform: rotate(105deg) translateY(-56rpx); }
.orbit-dot:nth-child(8) { transform: rotate(242.5deg) translateY(-56rpx); }
@keyframes spiral-spin-back { to { transform: rotate(-360deg); } }
.compact-avatar-button { display: flex; flex: none; align-items: center; justify-content: center; min-width: 0; width: 88rpx; min-height: 88rpx; margin: 0; padding: 0; border: 1rpx solid var(--sakura-stroke); border-radius: 50%; background: var(--sakura-wash); }
.compact-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; }
.compact-avatar.placeholder { display: flex; align-items: center; justify-content: center; }
.compact-cat-copy { flex: 1; min-width: 0; }
.compact-label { display: block; color: var(--sakura-muted); font-size: 24rpx; line-height: 1.55; }
.compact-cat-name { display: block; margin-top: 8rpx; color: var(--sakura-ink); font-size: 32rpx; font-weight: 600; line-height: 1.45; word-break: break-word; }
.compact-picker { flex: none; max-width: 136rpx; }
.compact-switch { display: flex; flex: none; align-items: center; justify-content: center; min-height: 88rpx; min-width: 88rpx; width: auto; max-width: 136rpx; padding: 14rpx 8rpx; margin: 0; color: var(--sakura-accent); background: transparent; font-size: 26rpx; font-weight: 600; line-height: 1.5; white-space: normal; word-break: break-word; }
.compact-house-row { display: flex; gap: 16rpx; align-items: center; margin-top: 8rpx; border-top: 1rpx solid var(--sakura-stroke); }
.compact-house-label { flex: none; color: #806570; font-size: 24rpx; }
.compact-house-picker { flex: 1; min-width: 0; }
.compact-house-value { display: flex; align-items: center; min-height: 88rpx; flex: 1; min-width: 0; padding: 12rpx 0; color: #6f5a64; font-size: 26rpx; line-height: 1.5; word-break: break-word; }
.garden-home .house-quick-grid { margin-top: 0; }
.garden-home .house-quick-action { font-size: 24rpx; font-weight: 500; min-height: 88rpx; border-color: var(--sakura-stroke); background: var(--sakura-paper); }
.garden-home .house-quick-action.invite { color: var(--sakura-accent); background: var(--sakura-wash); }
.garden-home .section-title { margin-bottom: 0; color: var(--sakura-ink); font-size: 34rpx; font-weight: 600; }
.garden-home .status-grid { gap: 0; border: 1rpx solid var(--sakura-stroke); border-radius: 28rpx; overflow: hidden; background: #fff; }
.garden-home .status-card { min-height: 0; padding: 20rpx; border: 0; border-radius: 0; background: #fff; }
.garden-home .status-card:nth-child(odd) { border-right: 1rpx solid #f2dfe7; }
.garden-home .status-card:nth-child(-n+2) { border-bottom: 1rpx solid #f2dfe7; }
.garden-home .status-value { color: var(--sakura-ink); font-size: 30rpx; font-weight: 600; margin-top: 8rpx; }
.garden-home .status-detail { color: var(--sakura-body); margin-top: 8rpx; font-size: 24rpx; line-height: 1.65; }
.garden-home .status-label { color: var(--sakura-muted); font-size: 24rpx; font-weight: 400; }
.garden-home .status-progress { margin-top: 4rpx; padding-top: 0; background: #fff0f5; height: 6rpx; }
.garden-home .status-progress-bar { height: 6rpx; }
.garden-home .action-card { min-height: 0; border-color: var(--sakura-stroke); border-radius: 28rpx; background: var(--sakura-paper); }
.garden-home .action-card.coral { background: var(--sakura-wash); }
.garden-home .action-title, .garden-home .activity-title { color: var(--sakura-ink); font-size: 28rpx; font-weight: 600; }
.garden-home .action-desc, .garden-home .activity-detail { color: var(--sakura-body); font-size: 26rpx; line-height: 1.65; }
.garden-home .section-note { color: var(--sakura-muted); font-size: 24rpx; line-height: 1.55; }
.garden-home .action-link { color: var(--sakura-accent); font-size: 24rpx; font-weight: 500; }
.garden-home .activity-card, .garden-home .activity-empty { border-color: var(--sakura-stroke); box-shadow: 0 8rpx 24rpx #A5677D0A; }
.garden-home .activity-time { color: var(--sakura-muted); font-size: 23rpx; line-height: 1.55; }
.garden-home .activity-empty-note { color: var(--sakura-body); font-size: 24rpx; line-height: 1.65; }
.garden-home .privacy-note { color: var(--sakura-muted); font-size: 24rpx; line-height: 1.65; }

.feedback-toast { margin-top: 18rpx; padding: 18rpx 24rpx; border: 1rpx solid #f2d7e1; border-radius: 22rpx; color: #a74665; background: #fff0f5; font-size: 24rpx; font-weight: 600; line-height: 1.55; text-align: center; animation: feedback-in .22s ease-out; word-break: break-word; }
@keyframes feedback-in { from { opacity: 0; transform: translateY(-8rpx); } to { opacity: 1; transform: translateY(0); } }

.house-quick-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; margin-top: 14rpx; }
.house-quick-grid.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.house-quick-action { display: flex; align-items: center; justify-content: center; gap: 8rpx; min-width: 0; min-height: 88rpx; padding: 12rpx 6rpx; border: 1rpx solid #f0dfe6; border-radius: 20rpx; color: #6f5a64; background: #fff9fb; font-size: 21rpx; font-weight: 600; line-height: 1.4; text-align: center; word-break: break-word; }
.house-quick-action.invite { color: #c94e70; background: #fff0f5; }
.house-quick-action:active { transform: scale(.98); }
.inline-warning { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; min-height: 88rpx; margin-top: 12rpx; padding: 14rpx 18rpx; border-radius: 20rpx; color: #875d27; background: #fff4df; font-size: 21rpx; line-height: 1.55; }
.inline-warning > text:first-child { flex: 1; min-width: 0; word-break: break-word; }
.warning-action { flex: none; color: #bb6d21; font-weight: 700; }

.section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; margin: 42rpx 4rpx 20rpx; }
.section-heading-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 5rpx; }
.section-title { color: #382d32; font-size: 34rpx; font-weight: 700; line-height: 1.4; word-break: break-word; }
.section-note { color: #8c747e; font-size: 22rpx; line-height: 1.5; word-break: break-word; }

.status-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.status-card { display: flex; min-width: 0; min-height: 202rpx; flex-direction: column; padding: 24rpx; border: 1rpx solid rgba(215,153,176,.18); border-radius: 28rpx; background: #fff; }
.status-label { color: #806872; font-size: 21rpx; font-weight: 600; line-height: 1.45; }
.status-value { display: block; margin-top: 8rpx; color: #382d32; font-size: 37rpx; font-weight: 700; line-height: 1.3; word-break: break-word; }
.status-detail { display: block; margin-top: 8rpx; color: #765f69; font-size: 21rpx; line-height: 1.5; word-break: break-word; }
.status-progress { overflow: hidden; width: 100%; height: 10rpx; margin-top: auto; padding-top: 14rpx; border-radius: 8rpx; background: linear-gradient(to bottom, transparent 14rpx, rgba(255,255,255,.72) 14rpx); box-sizing: content-box; }
.status-progress-bar { height: 10rpx; border-radius: 8rpx; background: #ff6f91; transition: width .24s ease-out; }

.action-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; }
.action-card { position: relative; display: flex; flex-direction: column; min-width: 0; min-height: 246rpx; padding: 26rpx; border: 1rpx solid rgba(215,153,176,.16); border-radius: 30rpx; background: #fff; }
.action-card:active { transform: scale(.98); }
.action-icon { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; margin-bottom: 16rpx; border: 1rpx solid rgba(217,79,117,.1); border-radius: 20rpx; background: rgba(255,255,255,.86); }
.action-title { color: #382d32; font-size: 29rpx; font-weight: 700; line-height: 1.4; word-break: break-word; }
.action-desc { display: block; margin-top: 8rpx; color: #765f69; font-size: 22rpx; line-height: 1.55; word-break: break-word; }
.action-link { align-self: flex-start; margin-top: auto; padding-top: 16rpx; color: #b74e6c; font-size: 21rpx; font-weight: 600; line-height: 1.4; word-break: break-word; }

.activity-card { overflow: hidden; padding: 0 26rpx; }
.activity-row { display: grid; grid-template-columns: 18rpx minmax(0, 1fr); column-gap: 18rpx; min-height: 118rpx; padding: 22rpx 0; border-bottom: 1rpx solid #f1e4e9; }
.activity-row:last-child { border-bottom: 0; }
.activity-row:active { opacity: .65; }
.activity-dot { grid-row: 1 / span 2; align-self: start; width: 18rpx; height: 18rpx; margin-top: 11rpx; border-radius: 9rpx; background: #d7c5cd; }
.activity-dot.coral { background: #ff7d9d; }
.activity-dot.mint { background: #58ad91; }
.activity-dot.lilac { background: #c9a3b6; }
.activity-dot.cream { background: #e3b7c8; }
.activity-copy { grid-column: 2; min-width: 0; }
.activity-title { display: block; color: #382d32; font-size: 25rpx; font-weight: 700; line-height: 1.45; word-break: break-word; }
.activity-detail { display: block; margin-top: 4rpx; color: #765f69; font-size: 21rpx; line-height: 1.55; word-break: break-word; }
.activity-time { grid-column: 2; margin-top: 5rpx; color: #a38b95; font-size: 19rpx; line-height: 1.4; word-break: break-word; }
.activity-empty { display: flex; align-items: center; gap: 18rpx; min-height: 142rpx; padding: 24rpx 28rpx; }
.activity-empty-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 22rpx; background: #fff0f5; }
.activity-empty-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 4rpx; }
.activity-empty-title { color: #382d32; font-size: 25rpx; font-weight: 700; line-height: 1.45; word-break: break-word; }
.activity-empty-note { color: #8c747e; font-size: 21rpx; line-height: 1.55; word-break: break-word; }

@media (max-width: 360px) {
  .action-grid { grid-template-columns: minmax(0, 1fr); }
  .house-quick-grid { gap: 6rpx; }
  .house-quick-action { gap: 5rpx; padding-left: 3rpx; padding-right: 3rpx; font-size: 19rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .avatar-orbit-ring { animation: none; }
  .petal-field { display: none; }
}
