.identity-page { padding-top: 28rpx; }
.identity-hero { display: flex; align-items: center; gap: 24rpx; padding: 32rpx; border: 1rpx solid #f0dce5; border-radius: 32rpx; background: linear-gradient(145deg,#fff0f5,#f3ecff); box-shadow: 0 12rpx 30rpx rgba(119,64,86,.07); }
.identity-hero-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 118rpx; min-height: 118rpx; border-radius: 38rpx; background: rgba(255,255,255,.82); font-size: 48rpx; }
.identity-hero-copy { flex: 1; min-width: 0; }
.identity-eyebrow { display: block; color: #d94f75; font-size: 21rpx; font-weight: 600; line-height: 1.45; }
.identity-title { display: block; margin-top: 7rpx; font-size: 34rpx; font-weight: 700; line-height: 1.4; word-break: break-word; }
.identity-subtitle { display: block; margin-top: 10rpx; color: #765f69; font-size: 23rpx; line-height: 1.65; word-break: break-word; }
.identity-warning { margin-top: 20rpx; padding: 20rpx 24rpx; border-radius: 20rpx; color: #8b581b; background: #fff3d8; font-size: 23rpx; line-height: 1.65; word-break: break-word; }
.feedback { margin-top: 20rpx; padding: 20rpx 24rpx; border-radius: 20rpx; font-size: 24rpx; line-height: 1.6; word-break: break-word; }
.feedback.error { color: #b94955; background: #ffe8ed; }
.feedback.success { color: #3f8e75; background: #e8f5f0; }
.loading-card { display: flex; flex-direction: column; align-items: center; gap: 10rpx; margin-top: 28rpx; padding: 52rpx 28rpx; text-align: center; }
.loading-orbit { display: flex; align-items: center; justify-content: center; width: 92rpx; height: 92rpx; border-radius: 50%; background: #fff0f5; font-size: 38rpx; animation: identity-breathe 1.4s ease-in-out infinite; }
@keyframes identity-breathe { 0%,100% { transform: scale(.95); opacity: .65; } 50% { transform: scale(1.05); opacity: 1; } }
.loading-title { margin-top: 10rpx; font-size: 28rpx; font-weight: 700; line-height: 1.5; }
.loading-card .muted { font-size: 23rpx; line-height: 1.6; }
.task-summary { margin-top: 26rpx; }
.summary-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16rpx; }
.summary-kicker { display: block; color: #9d8490; font-size: 21rpx; line-height: 1.45; }
.summary-value { display: block; margin-top: 4rpx; font-size: 29rpx; font-weight: 700; line-height: 1.45; }
.mode-pill { padding: 9rpx 16rpx; border-radius: 20rpx; color: #3f8e75; background: #e8f5f0; font-size: 21rpx; font-weight: 600; line-height: 1.4; }
.mode-pill.simulation { color: #8b581b; background: #fff3d8; }
.task-notice, .simulation-note { display: block; margin-top: 16rpx; font-size: 23rpx; line-height: 1.65; word-break: break-word; }
.task-notice { color: #765f69; }
.simulation-note { padding: 16rpx 18rpx; border-radius: 16rpx; color: #8b581b; background: #fff3d8; }
.refresh-button { width: 100%; margin-top: 20rpx; }
.candidate-list { display: flex; flex-direction: column; gap: 18rpx; }
.candidate-card { display: grid; grid-template-columns: 58rpx minmax(0,1fr); gap: 16rpx; align-items: start; padding: 24rpx; border: 1rpx solid #f0dce5; border-radius: 26rpx; background: #fff; box-shadow: 0 8rpx 22rpx rgba(119,64,86,.05); }
.candidate-rank { display: flex; align-items: center; justify-content: center; width: 58rpx; min-height: 58rpx; border-radius: 20rpx; color: #d94f75; background: #fff0f5; font-size: 25rpx; font-weight: 700; }
.candidate-copy { min-width: 0; }
.candidate-name { display: block; font-size: 29rpx; font-weight: 700; line-height: 1.45; word-break: break-word; }
.candidate-evidence { display: block; margin-top: 7rpx; color: #765f69; font-size: 23rpx; line-height: 1.6; word-break: break-word; }
.candidate-button { grid-column: 1 / -1; width: 100%; min-height: 88rpx; margin: 2rpx 0 0; padding: 18rpx 22rpx; border-radius: 44rpx; color: #d94f75; background: #fff0f5; font-size: 24rpx; font-weight: 600; line-height: 1.45; }
.empty-candidates { display: flex; flex-direction: column; align-items: center; padding: 46rpx 28rpx; border: 1rpx dashed #ead1dc; border-radius: 26rpx; background: #fff; text-align: center; }
.empty-icon { font-size: 48rpx; }
.empty-title { margin-top: 10rpx; font-size: 28rpx; font-weight: 700; line-height: 1.45; }
.empty-candidates .muted { margin-top: 9rpx; font-size: 23rpx; line-height: 1.65; word-break: break-word; }
.manual-card { display: flex; flex-direction: column; gap: 16rpx; }
.form-label { display: block; color: #765f69; font-size: 23rpx; font-weight: 600; line-height: 1.5; }
.picker-row, .form-input { display: flex; align-items: center; width: 100%; min-height: 88rpx; padding: 19rpx 22rpx; border: 1rpx solid #f0dce5; border-radius: 20rpx; background: #fff9fb; font-size: 25rpx; line-height: 1.5; }
.picker-row { justify-content: space-between; gap: 16rpx; }
.picker-row > text:first-child { min-width: 0; word-break: break-word; }
.picker-arrow { flex: none; color: #c9abb8; font-size: 30rpx; }
.manual-button { width: 100%; }
.manual-divider { display: flex; align-items: center; justify-content: center; margin: 6rpx 0; color: #b99ca9; font-size: 21rpx; line-height: 1.4; }
.manual-divider::before, .manual-divider::after { content: ''; flex: 1; height: 1rpx; background: #f0dce5; }
.manual-divider text { padding: 0 18rpx; }
.unsure-button, .danger-soft-button { width: 100%; min-height: 88rpx; margin: 4rpx 0 0; padding: 18rpx 22rpx; border-radius: 44rpx; font-size: 24rpx; font-weight: 600; line-height: 1.45; }
.unsure-button { color: #765f69; background: #f7f1f4; }
.completed-card { display: flex; flex-direction: column; align-items: center; margin-top: 26rpx; padding: 38rpx 28rpx; text-align: center; }
.completed-icon { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; border-radius: 50%; color: #fff; background: #69b69c; font-size: 38rpx; font-weight: 700; }
.completed-title { margin-top: 16rpx; font-size: 28rpx; font-weight: 700; line-height: 1.45; }
.completed-name { margin-top: 7rpx; color: #d94f75; font-size: 34rpx; font-weight: 700; line-height: 1.45; word-break: break-word; }
.completed-desc { margin-top: 10rpx; color: #765f69; font-size: 23rpx; line-height: 1.65; word-break: break-word; }
.danger-soft-button { margin-top: 22rpx; color: #b94955; background: #ffe8ed; }
.capture-guide { margin: 34rpx 0 0; padding: 24rpx; border-radius: 24rpx; background: #f3ecff; }
.guide-title { display: block; color: #66577b; font-size: 25rpx; font-weight: 700; line-height: 1.5; }
.guide-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx 18rpx; margin-top: 14rpx; }
.guide-grid text { color: #796c91; font-size: 22rpx; line-height: 1.55; word-break: break-word; }

@media (max-width: 360px) {
  .identity-hero { align-items: flex-start; }
  .identity-hero-icon { width: 92rpx; min-height: 92rpx; font-size: 38rpx; }
  .guide-grid { grid-template-columns: 1fr; }
}
