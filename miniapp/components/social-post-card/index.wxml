<view class="story-card">
  <view class="story-author">
    <view class="story-avatar" aria-hidden="true">{{story.author.initial}}</view>
    <view class="story-author-copy"><text class="story-author-name">{{story.author.nickname}}</text><text wx:if="{{story.timeLabel}}" class="story-time">{{story.timeLabel}}</text></view>
    <text wx:if="{{showStatus && story.statusLabel}}" class="story-status">{{story.statusLabel}}</text>
  </view>
  <text class="story-content" user-select="{{detail}}">{{story.content}}</text>
  <block wx:if="{{photoSlot}}">
    <view wx:if="{{story.photos.length && !photoFailed && !photoBlocked}}" class="story-photo-frame" bindtap="previewPhoto" aria-role="button" aria-label="查看猫咪照片">
      <image class="story-photo" src="{{story.photos[0]}}" data-src="{{story.photos[0]}}" data-revision="{{photoRevision}}" mode="aspectFill" lazy-load="{{!detail}}" binderror="onPhotoError" />
      <text wx:if="{{story.photos.length > 1}}" class="story-photo-count">共 {{story.photos.length}} 张</text>
    </view>
    <view wx:if="{{photoMessage || photoLoading}}" class="story-photo-recovery" aria-live="polite">
      <text class="story-photo-message">{{photoMessage}}</text>
      <button wx:if="{{photoCanRetry}}" class="story-photo-retry" bindtap="retryPhotos" loading="{{photoLoading}}" disabled="{{photoLoading}}">{{photoLoading ? '正在加载照片…' : '重新加载照片'}}</button>
    </view>
  </block>
  <view wx:if="{{story.hasCat}}" class="story-cat">
    <icon name="paw" size="{{28}}" color="#B94768" />
    <view class="story-cat-copy"><text class="story-cat-name">{{story.cat.name}}</text><text wx:if="{{story.cat.breed || story.cat.coatColor}}" class="story-cat-meta">{{story.cat.breed}}{{story.cat.breed && story.cat.coatColor ? ' · ' : ''}}{{story.cat.coatColor}}</text></view>
  </view>
  <block wx:if="{{!detail}}">
    <view wx:if="{{story.comments.length}}" class="story-comments" bindtap="openPost" aria-role="button" aria-label="查看故事与回应">
      <view class="story-comment" wx:for="{{story.comments}}" wx:key="id"><text class="story-comment-author">{{item.author.nickname}}：</text><text>{{item.content}}</text></view>
    </view>
    <button class="story-reply" bindtap="reply"><icon name="message" size="{{30}}" color="#B94768" /><text>接句话</text><text wx:if="{{story.commentCount}}" class="story-reply-count">{{story.commentCount}} 条回应</text></button>
  </block>
</view>
